# LYNX Management System — Environment Variables Example
# ⚠️ DO NOT put real values here. Use Replit Secrets instead.
# This file is for documentation only.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=          # Bot token from Discord Developer Portal
CLIENT_ID=              # Application/Client ID from Discord Developer Portal
DATABASE_URL=           # PostgreSQL connection string (auto-provided by Replit)

# ── RECOMMENDED ───────────────────────────────────────────────────────────────
GUILD_ID=               # Your Discord server ID (required for guild-scoped commands)
OWNER_ID=               # Your Discord user ID (bot owner)

# ── ROLE IDs (right-click role → Copy ID in Discord) ─────────────────────────
ADMIN_ROLE_ID=          # Administrator role ID
MANAGEMENT_ROLE_ID=     # Management role ID
SUPPORT_ROLE_ID=        # Support staff role ID
MODERATOR_ROLE_ID=      # Moderator role ID

# ── CHANNEL/CATEGORY IDs ──────────────────────────────────────────────────────
TICKET_CATEGORY_ID=         # Category where open tickets go
CLOSED_TICKET_CATEGORY_ID=  # Category where closed tickets go
REVIEW_TICKET_CATEGORY_ID=  # Category for tickets under review
WELCOME_CHANNEL_ID=         # Channel for welcome messages
GOODBYE_CHANNEL_ID=         # Channel for goodbye messages
LOG_CHANNEL_ID=             # General log channel
MOD_LOG_CHANNEL_ID=         # Moderation log channel
TRANSCRIPT_CHANNEL_ID=      # Channel where ticket transcripts are sent
SUGGESTION_CHANNEL_ID=      # Suggestion channel (optional)

# ── BOT SETTINGS ──────────────────────────────────────────────────────────────
TWITCH_URL=https://twitch.tv/lynx   # Twitch URL for streaming status
BOT_STATUS_TEXT=LYNX System         # Activity text shown in Discord
COMMAND_SCOPE=guild                 # "guild" for fast dev, "global" for production
PORT=3000                           # Health server port (Replit sets this automatically)
